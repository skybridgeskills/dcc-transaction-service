DEFAULT_EXCHANGE_HOST=http://localhost:4004

# Interaction UI: when true (default), users can expand advanced verification details.
# UI_SHOW_DETAILS=false
REDIS_URI=redis://127.0.0.1:6379
KEYV_WRITE_DELAY=50

# Append-only exchange journal (JSONL). Durable record of exchange-lifecycle
# events, separate from the TTL-evicted Keyv exchange record. Unset — the
# default — makes it a no-op: no file is created and nothing is recorded.
# The file has no TTL and is never truncated by the service.
# EXCHANGE_JOURNAL_PATH=./.local/exchange-journal.jsonl
STATUS_SERVICE="http://localhost:4008" # default, remove to disable
# Bearer token for the status service. vcalm-status-service authenticates every
# write, so allocate needs one; `pnpm provision-tenant` there prints it.
# STATUS_SERVICE_TOKEN=

# Tenant auth (server + CLI) - set TENANT_TOKEN_DEFAULT to enable server auth
TENANT_TOKEN_DEFAULT=example-tenant-token
TENANT_TOKEN_OTHERTENANT=example-other-tenant-token

# Optional: multiple issuer instances per tenant (signing-service tenant + DID + cryptosuite).
# TENANT_ISSUER_1_ID_EDDSATEST=did:web:example.com
# TENANT_ISSUER_1_CRYPTOSUITE_EDDSATEST=eddsa-rdfc-2022
# TENANT_ISSUER_1_SIGNING_TENANT_EDDSATEST=eddsatest
#
# A path-form did:web instance additionally causes this service to publish that
# DID's document, by proxying the signing service that derives it. No extra
# configuration: the ID gives the path and SIGNING_TENANT names the seed holder.
# TENANT_ISSUER_1_ID_EXAMPLE=did:web:example.com:ui:example-tenant
# TENANT_ISSUER_1_SIGNING_TENANT_EXAMPLE=example-tenant
#   -> served at /ui/example-tenant/did.json  (see README, "did:web document hosting")

# Protocol profile served when neither the exchange (`variables.protocolProfileName`)
# nor its tenant names one. A NAME, resolved against this service's own registry;
# see docs/protocol-profiles.md.
#
# Unset means no layer names a profile, and resolution throws rather than guessing
# which bytes to emit. Nothing resolves a profile yet, so leaving it unset is
# correct today.
# DEFAULT_PROTOCOL_PROFILE=oid4vp-1.0-by-value-dcql-redirect-uri
#
# Per-tenant override. Suffix uppercased, as TENANT_ISSUER_* is.
# TENANT_PROFILE_OTHERTENANT=oid4vp-1.0-by-value-dcql-redirect-uri

# OAuth2 client_credentials access JWT (HS256). Required to issue tokens at POST /oauth/token.
# client_id in token requests must match tenant name (same key as TENANT_TOKEN_<name>, lowercased).
ACCESS_JWT_SECRET=generate-a-long-random-secret-for-production

# Optional OpenID Federation issuer registries (repeat per slug).
# Registry name for trustedRegistries / DEFAULT_TRUSTED_REGISTRIES is OIDF_<SLUG>.
# REGISTRY_OIDF_SKY_TRUST_ANCHOR_EC=https://ta.example/.well-known/openid-federation

# Optional VC Recognition issuer registries (repeat per slug).
# Registry name for trustedRegistries / DEFAULT_TRUSTED_REGISTRIES is VC_RECOGNITION_<SLUG>.
# REGISTRY_VC_RECOGNITION_SKY_URL=https://issuer.example/recognition-vc.json
# REGISTRY_VC_RECOGNITION_SKY_ACCEPTED_ISSUERS=did:web:trusted-issuer.example

# CLI configuration
# The tenant is determined solely by CLI_TENANT_TOKEN — there is no separate
# tenant-name variable; the server derives the tenant from this token.
CLI_TENANT_TOKEN=example-tenant-token
# CLI_EXCHANGE_HOST=https://your-tunnel.ngrok.io  # override public exchange host (defaults to server's DEFAULT_EXCHANGE_HOST)
