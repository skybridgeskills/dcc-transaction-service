            },
            {
              "method": "web"
            },
            {
              "method": "jwk"
            }
          ]
        }
      ],
      "interact": {
        "service": [
          {
            "type": "VerifiableCredentialApiExchangeService",
            "serviceEndpoint": "http://localhost:4005/workflows/verify/exchanges/{exchangeId}"
          },
          {
            "type": "UnmediatedPresentationService2021",
            "serviceEndpoint": "http://localhost:4005/workflows/verify/exchanges/{exchangeId}"
          }
        ]
      },
      "challenge": "{challenge}",
      "domain": "http://localhost:4005/workflows/verify/exchanges/{exchangeId}",
      "acceptedCryptosuites": [
        {
          "cryptosuite": "eddsa-rdfc-2022"
        },
        {
          "cryptosuite": "ecdsa-rdfc-2019"
        },
        {
          "cryptosuite": "ed25519-signature-2020"
